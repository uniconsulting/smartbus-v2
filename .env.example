# Заявки в общую беседу MAX. Добавьте туда бота и укажите числовой ID группы.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Личный получатель, если ID группы не задан.
MAX_USER_ID=
# Необязательно. Сетевой интерфейс для запросов к MAX, если VPN прерывает TLS.
# Пустое значение оставляет системный маршрут. Укажите интерфейс с IPv4 на конкретном хосте.
SMARTBUS_MAX_INTERFACE=

# Запасной вариант, если MAX_BOT_TOKEN не задан.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичные контакты для сайта (необязательно до получения реальных данных).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Постоянный каталог с базой, файлами документов и ключом интеграций.
SMARTBUS_DATA_DIR=
# Необязательный внешний ключ AES-256 (32 случайных байта в base64).
SMARTBUS_INTEGRATION_KEY=

# Включайте только за собственным прокси на закрытом порту, который заменяет X-Real-IP и X-Forwarded-Proto.
SMARTBUS_TRUST_PROXY=0
